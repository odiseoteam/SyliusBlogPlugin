{% import '@SyliusAdmin/shared/helper/translations.html.twig' as translations %}

{% set form = hookable_metadata.context.form %}

<div class="col-12">
    <div class="card mb-3">
        <div class="card-header">
            <div class="card-title">{{ 'sylius.ui.translations'|trans }}</div>
        </div>
        <div class="card-body">
            <div class="row">
                {{ translations.with_hook(form.translations, hookable_metadata.prefixes, null, { accordion_flush: true }) }}
            </div>
        </div>
    </div>
</div>
