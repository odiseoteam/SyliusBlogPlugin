{# The button runs the generateSlug action of the form's live component; "generate_title" names its source field. #}
{% set form = hookable_metadata.context.form %}
{% set locale = hookable_metadata.context.locale %}

<div class="col-12 col-md-6">
    <div class="mb-3 field">
        {{ form_label(form.slug) }}
        <div class="input-group">
            {{ form_widget(form.slug, sylius_test_form_attribute('slug', locale)) }}
            <button
                class="btn btn-outline-secondary"
                type="button"
                title="{{ (hookable_metadata.configuration.generate_title|default('odiseo_blog.ui.generate_slug'))|trans }}"
                data-action="live#action"
                data-live-action-param="debounce(300)|generateSlug"
                data-live-locale-code-param="{{ locale }}"
                {{ sylius_test_html_attribute('generate-slug-button', locale) }}
            >
                {{ ux_icon('tabler:wand', {'class': 'icon mx-0'}) }}
            </button>
        </div>
        {{ form_errors(form.slug) }}
    </div>
</div>
