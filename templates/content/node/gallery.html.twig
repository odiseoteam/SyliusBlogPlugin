{% if images %}<figure class="odiseo-blog-gallery figure d-block my-4"><div class="row row-cols-2 row-cols-md-{{ columns }} g-2">{% for image in images %}<div class="col"><a href="{{ image.href }}"><img src="{{ image.src }}" alt="{{ image.alt }}" width="{{ image.size }}" height="{{ image.size }}" loading="lazy" decoding="async" class="img-fluid rounded"></a></div>{% endfor %}</div>{% if caption %}<figcaption class="figure-caption text-center mt-2">{{ caption }}</figcaption>{% endif %}</figure>{% endif %}
