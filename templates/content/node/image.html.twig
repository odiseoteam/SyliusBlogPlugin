{% if image %}
{%- set img -%}
<img src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="{{ image.sizes }}" alt="{{ image.alt }}"{% if image.width %} width="{{ image.width }}" height="{{ image.height }}"{% endif %} loading="lazy" decoding="async" class="figure-img img-fluid rounded d-block mx-auto">{% if image.caption %}<figcaption class="figure-caption text-center">{{ image.caption }}</figcaption>{% endif %}
{%- endset -%}
{%- if image.float -%}
<figure class="odiseo-blog-image figure col-12 col-md-{{ image.columns }} {{ image.float == 'left' ? 'float-md-start me-md-4' : 'float-md-end ms-md-4' }} mb-3">{{ img }}</figure>
{%- else -%}
<div class="odiseo-blog-image row justify-content-center my-4"><figure class="figure col-12 col-md-{{ image.columns }} mb-0">{{ img }}</figure></div>
{%- endif %}
{%- endif %}
