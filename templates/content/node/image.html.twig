{% if image %}<div class="odiseo-blog-image row justify-content-center my-4"><figure class="figure col-12 col-md-{{ image.columns }} mb-0"><img src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="{{ image.sizes }}" alt="{{ image.alt }}"{% if image.width %} width="{{ image.width }}" height="{{ image.height }}"{% endif %} loading="lazy" decoding="async" class="figure-img img-fluid rounded d-block mx-auto">{% if image.caption %}<figcaption class="figure-caption text-center">{{ image.caption }}</figcaption>{% endif %}</figure></div>{% endif %}
