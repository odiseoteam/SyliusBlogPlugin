<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <!-- Transform contexts -->
        <service id="odiseo_blog.behat.context.transform.article_tag" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Transform\ArticleTagContext">
            <argument type="service" id="odiseo_blog.repository.article_tag" />
            <tag name="fob.context_service" />
        </service>

        <service id="odiseo_blog.behat.context.transform.article_category" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Transform\ArticleCategoryContext">
            <argument type="service" id="odiseo_blog.repository.article_category" />
            <tag name="fob.context_service" />
        </service>

        <!-- Setup contexts -->
        <service id="odiseo_blog.behat.context.setup.article_tag" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Setup\ArticleTagContext">
            <argument type="service" id="odiseo_blog.factory.article_tag" />
            <argument type="service" id="odiseo_blog.manager.article_tag" />
            <argument type="service" id="sylius.generator.slug" />
            <tag name="fob.context_service" />
        </service>

        <service id="odiseo_blog.behat.context.setup.blog_configuration" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Setup\BlogConfigurationContext">
            <argument type="service" id="odiseo_blog.provider.channel_configuration" />
            <argument type="service" id="odiseo_blog.manager.channel_configuration" />
            <tag name="fob.context_service" />
        </service>

        <service id="odiseo_blog.behat.context.setup.article_category" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Setup\ArticleCategoryContext">
            <argument type="service" id="odiseo_blog.factory.article_category" />
            <argument type="service" id="odiseo_blog.manager.article_category" />
            <argument type="service" id="sylius.generator.slug" />
            <argument type="service" id="sylius.uploader.image" />
            <argument type="service" id="behat.mink.parameters" />
            <tag name="fob.context_service" />
        </service>

        <!-- UI admin contexts -->
        <service id="odiseo_blog.behat.context.ui.admin.managing_categories" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Ui\Admin\ManagingCategoriesContext">
            <argument type="service" id="sylius.behat.current_page_resolver" />
            <argument type="service" id="odiseo_blog.behat.page.admin.article_category.create" />
            <argument type="service" id="odiseo_blog.behat.page.admin.article_category.create_for_parent" />
            <argument type="service" id="odiseo_blog.behat.page.admin.article_category.update" />
            <argument type="service" id="odiseo_blog.behat.context.transform.article_category" />
            <argument type="service" id="odiseo_blog.manager.article_category" />
            <tag name="fob.context_service" />
        </service>

        <service id="odiseo_blog.behat.context.ui.admin.managing_tags" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Ui\Admin\ManagingTagsContext">
            <argument type="service" id="sylius.behat.current_page_resolver" />
            <argument type="service" id="odiseo_blog.behat.page.admin.article_tag.index" />
            <argument type="service" id="odiseo_blog.behat.page.admin.article_tag.create" />
            <argument type="service" id="odiseo_blog.behat.page.admin.article_tag.update" />
            <argument type="service" id="odiseo_blog.manager.article_tag" />
            <tag name="fob.context_service" />
        </service>

        <service id="odiseo_blog.behat.context.ui.admin.managing_blog_configuration" class="Tests\Odiseo\SyliusBlogPlugin\Behat\Context\Ui\Admin\ManagingBlogConfigurationContext">
            <argument type="service" id="odiseo_blog.behat.page.admin.channel_configuration.index" />
            <argument type="service" id="odiseo_blog.behat.page.admin.channel_configuration.update" />
            <argument type="service" id="odiseo_blog.repository.channel_configuration" />
            <argument type="service" id="odiseo_blog.manager.channel_configuration" />
            <tag name="fob.context_service" />
        </service>
    </services>
</container>
