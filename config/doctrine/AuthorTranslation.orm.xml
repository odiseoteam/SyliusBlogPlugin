<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Odiseo\SyliusBlogPlugin\Entity\AuthorTranslation" table="odiseo_blog_author_translation">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="jobTitle" column="job_title" type="string" nullable="true"/>
        <field name="bio" type="text" nullable="true"/>
        <field name="metaTitle" column="meta_title" type="string" nullable="true"/>
        <field name="metaDescription" column="meta_description" type="string" nullable="true"/>
    </mapped-superclass>
</doctrine-mapping>
