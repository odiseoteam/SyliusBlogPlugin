<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Odiseo\SyliusBlogPlugin\Entity\ArticleAuthor" table="odiseo_blog_article_author">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="position" type="integer"/>

        <many-to-one field="article" target-entity="Odiseo\SyliusBlogPlugin\Entity\ArticleInterface" inversed-by="articleAuthors">
            <join-column name="article_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <!-- No cascade: an author who signs articles can't be deleted, only disabled. -->
        <many-to-one field="author" target-entity="Odiseo\SyliusBlogPlugin\Entity\AuthorInterface">
            <join-column name="author_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint columns="article_id,author_id" name="odiseo_blog_article_author_uidx"/>
        </unique-constraints>
    </mapped-superclass>
</doctrine-mapping>
