<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- id, type and path come from the mapping of Sylius' Image. -->
    <mapped-superclass name="Odiseo\SyliusBlogPlugin\Entity\ArticleImage" table="odiseo_blog_article_image">
        <one-to-one field="owner" target-entity="Odiseo\SyliusBlogPlugin\Entity\ArticleInterface" mapped-by="image"/>
    </mapped-superclass>
</doctrine-mapping>
